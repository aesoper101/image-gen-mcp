# image-gen-mcp configuration example — copy to .env or export into the environment
# Three-layer override: default < IMAGE_MCP_* env vars < --key=value CLI args

# ---- Global ----
# Provider list (order = default priority); when omitted, every provider with a
# configured API key is enabled automatically
IMAGE_MCP_PROVIDERS=openai,zhipu,google

# Max retries within a single provider (default 2)
IMAGE_MCP_MAX_RETRIES=2
# Max failovers: allowed switches to the next provider after the preferred one fails (default 1)
IMAGE_MCP_MAX_DEGRADATIONS=1
# Retry backoff base ms (exponential, default 1000)
IMAGE_MCP_RETRY_BACKOFF_MS=1000
# Request timeout ms (default 60000)
IMAGE_MCP_REQUEST_TIMEOUT_MS=60000
# Output mode: url | base64 | file (default url)
IMAGE_MCP_OUTPUT_MODE=url
# Directory for file mode (default ./output)
IMAGE_MCP_OUTPUT_DIR=./output

# ---- Providers (configure at least one) ----
# openai: https://api.openai.com/v1, default model gpt-image-1
IMAGE_MCP_OPENAI_API_KEY=sk-xxx
# IMAGE_MCP_OPENAI_BASE_URL=https://api.openai.com/v1
# IMAGE_MCP_OPENAI_MODEL=gpt-image-1
# IMAGE_MCP_OPENAI_PRIORITY=0

# zhipu (CogView, OpenAI-compatible endpoint): https://open.bigmodel.cn/api/paas/v4, default model cogview-4-flash
# IMAGE_MCP_ZHIPU_API_KEY=
# IMAGE_MCP_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# IMAGE_MCP_ZHIPU_MODEL=cogview-4-flash

# google (Gemini image models / Imagen, official @google/genai SDK)
# IMAGE_MCP_GOOGLE_API_KEY=
# IMAGE_MCP_GOOGLE_MODEL=gemini-2.5-flash-image

# dashscope (Alibaba Wan, OpenAI-compatible endpoint): https://dashscope.aliyuncs.com/compatible-mode/v1, default model wan2.7-image
# IMAGE_MCP_DASHSCOPE_API_KEY=
# IMAGE_MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# IMAGE_MCP_DASHSCOPE_MODEL=wan2.7-image

# openrouter (OpenAI-compatible, no default model — model must be passed at call time)
# IMAGE_MCP_OPENROUTER_API_KEY=
# IMAGE_MCP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# grok (xAI): https://api.x.ai/v1, default model grok-2-image
# IMAGE_MCP_GROK_API_KEY=
# IMAGE_MCP_GROK_BASE_URL=https://api.x.ai/v1

# siliconflow (OpenAI-compatible, no default model)
# IMAGE_MCP_SILICONFLOW_API_KEY=
# IMAGE_MCP_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# volcengine (ByteDance Ark, OpenAI-compatible, no default model; model = Ark endpoint id)
# IMAGE_MCP_VOLCENGINE_API_KEY=
# IMAGE_MCP_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
