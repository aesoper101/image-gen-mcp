{
  "name": "@inferai/image-gen-mcp",
  "version": "1.0.1",
  "description": "Multi-provider AI image generation MCP server (stdio) for agents without image capabilities. Unified ImageProvider abstraction, priority-based failover with retries, OpenAI-compatible + Google providers.",
  "keywords": [
    "mcp",
    "image-generation",
    "text2img",
    "openai",
    "gemini",
    "imagen",
    "cogview",
    "zhipu",
    "dashscope",
    "wanx",
    "openrouter",
    "grok",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aesoper101/image-gen-mcp"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "image-gen-mcp": "./dist/index.js"
  },
  "files": ["dist", "README.md", "README.zh-CN.md", ".env.example"],
  "scripts": {
    "build": "rslib",
    "changeset": "changeset",
    "check": "biome check --write",
    "dev": "rslib --watch",
    "format": "biome format --write",
    "prepare": "simple-git-hooks",
    "release": "changeset publish",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "version": "changeset version"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check",
    "pre-push": "pnpm format"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.11.9",
    "@rstest/core": "^0.11.9",
    "@rstest/coverage-v8": "^0.11.9",
    "@types/node": "^24.13.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
